# =============================================================
# HackFlow Environment Configuration
# =============================================================

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Jina Reader (optional)
JINA_API_KEY=your-jina-api-key

# -------------------------------------------------------------
# Transactional Email Providers
# -------------------------------------------------------------
# Option A: Brevo (Sendinblue) - RECOMMENDED
# Free tier: 300 emails/day forever. NO custom domain required!
# You can verify any personal Gmail / Outlook address as sender in Brevo.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-email@gmail.com
BREVO_SENDER_NAME=HackFlow

# Option B: Standard SMTP (Brevo SMTP, Gmail App Password, MailerLite, etc.)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# SMTP_FROM="HackFlow <your-email@gmail.com>"

# Option C: Resend (Requires custom domain to send to non-owner emails)
# RESEND_API_KEY=re_xxxx

# Cron & Application
CRON_SECRET=hackflow-cron-secret-change-in-production
# Production URL (Auto-detected on Vercel via VERCEL_PROJECT_PRODUCTION_URL).
# In local dev: http://localhost:3000
# In production with custom domain: set to https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
